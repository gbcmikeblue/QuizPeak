# ===== 知巅 QuizPeak 生产环境变量模板 =====
# 复制为 .env.production 后填写真实值（该文件已被 gitignore，请勿提交）
#   cp .env.production.example .env.production

# ---------- 运行时 ----------
NODE_ENV=production
PORT=8080
TZ=Asia/Shanghai

# ---------- 数据库（docker compose 内使用服务名 postgres）----------
DATABASE_URL=postgresql://quizpeak:CHANGE_ME@postgres:5432/quizpeak?schema=public

# compose 中 postgres 容器的初始化账号（与上面 DATABASE_URL 保持一致）
POSTGRES_USER=quizpeak
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=quizpeak

# ---------- 鉴权 ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_64_BYTES_RANDOM
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# 允许跨域的前端地址，逗号分隔；同域反代时可留空
CORS_ORIGINS=https://quizpeak.example.com,https://admin.quizpeak.example.com

# ---------- 短信 ----------
# console = 只打日志不真发；接入阿里云后改为 aliyun 并补全下面四项
SMS_PROVIDER=console
# 生产必须为 false，否则验证码会在接口返回体与后台页面明文可见
SMS_DEV_MODE=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---------- 前端（构建期注入，Next 的 NEXT_PUBLIC_* 会被内联进产物）----------
NEXT_PUBLIC_API_BASE=/api

# ---------- 备份与告警（供 deploy/*.sh 使用）----------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
# 钉钉/飞书/企业微信机器人地址，留空则只写本地日志
ALERT_WEBHOOK_URL=

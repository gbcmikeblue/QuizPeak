# 统一换行符，避免 Windows/macOS 协同产生全文件 diff
* text=auto eol=lf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 锁文件：不参与语言统计、避免合并冲突
package-lock.json -diff linguist-generated

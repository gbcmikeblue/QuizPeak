# 服务端口
PORT=8080
# 运行环境：development / production
NODE_ENV=development
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL
DATABASE_URL="postgresql://quizpeak:quizpeak@localhost:5432/quizpeak?schema=public"

# JWT
JWT_SECRET=please-change-me-in-production
JWT_ACCESS_EXPIRES=1800
JWT_REFRESH_EXPIRES=604800

# 短信（阿里云）
SMS_PROVIDER=console
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 微信支付 v3
WXPAY_MCH_ID=
WXPAY_APP_ID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_API_V3_KEY=
WXPAY_NOTIFY_URL=

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# 对象存储
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_HOST=

# API 镜像：构建上下文为仓库根目录
# docker build -f deploy/Dockerfile.server -t quizpeak-api .
FROM node:22-alpine

WORKDIR /app
RUN apk add --no-cache openssl libc6-compat wget
ENV NODE_ENV=production

# 先只拷贝清单，利用层缓存
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/i18n/package.json packages/i18n/
COPY server/package.json server/
COPY admin/package.json admin/
COPY web-pc/package.json web-pc/
RUN npm ci

COPY . .

RUN npm run build:shared \
  && npx prisma generate --schema server/prisma/schema.prisma \
  && npm run build -w @quizpeak/server

# 上传目录：服务端以 process.cwd()/uploads 落盘（容器内即 /app/uploads），运行时用 volume 持久化
RUN mkdir -p /app/uploads

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/api/health || exit 1

# 启动前执行迁移，避免忘记 migrate
CMD ["sh", "-c", "npx prisma migrate deploy --schema server/prisma/schema.prisma && node server/dist/main.js"]
